{
  "name": "awdf-reference-implementation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:builder-export && npm run test:description && npm run test:awdf && npm run test:rules && npm run test:scanner && npm run test:simulator && npm run test:evaluator && npm run test:graph && npm run build",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "validate:awdf": "node scripts/validate-awdf.mjs ai-setup.json",
    "validate:settings": "node scripts/validate-settings.mjs ai-setup-settings.json",
    "test:awdf": "node scripts/test-awdf.mjs",
    "test:simulator": "node scripts/test-simulator.mjs",
    "test:scanner": "node scripts/test-scanner.mjs && node scripts/test-configuration-links.mjs && node scripts/test-scan-safety.mjs",
    "test:rules": "node scripts/test-ai-tool-rules.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "validate:simulation": "node scripts/validate-awdf-simulation.mjs simulation-result.json ai-setup.json",
    "scan:setup": "node scripts/describe-setup.mjs . ai-setup.json ai-setup-settings.json",
    "test:evaluator": "node scripts/test-instruction-links.mjs && node --test scripts/test-evaluator.mjs",
    "evaluate:setup": "node scripts/evaluate-setup.mjs",
    "benchmark:evaluator": "node scripts/benchmark-evaluator.mjs",
    "test:ui": "node scripts/prepare-evaluator-ui.mjs && node scripts/test-evaluator-ui.mjs && node scripts/test-design-ui.mjs && node scripts/test-component-ui.mjs && node scripts/test-viewport-ui.mjs && node scripts/test-palette-ui.mjs",
    "test:graph": "node scripts/test-graph-model.mjs",
    "describe:setup": "node scripts/describe-setup.mjs . ai-setup.json ai-setup-settings.json",
    "test:description": "node scripts/test-description.mjs && node scripts/test-description-regressions.mjs",
    "test:description:ui": "npm run test:description && node scripts/test-description-ui.mjs",
    "test:builder-export": "node scripts/test-builder-export.mjs",
    "test:builder-export:ui": "node scripts/test-description.mjs && node scripts/test-builder-export-ui.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {}
}
