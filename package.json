{
  "name": "awdf-reference-implementation",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.mjs",
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "preview": "node server.mjs",
    "describe:setup": "node scripts/describe-setup.mjs . ai-setup.json ai-setup-settings.json",
    "assess:setup": "node scripts/assess-setup.mjs",
    "catalog:candidate": "node scripts/update-catalog.mjs candidate",
    "recorder:prepare": "node scripts/prepare-recorder.mjs",
    "prompt:run": "node scripts/prompt-run.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "validate:awdf": "node scripts/validate-awdf.mjs ai-setup.json",
    "validate:settings": "node scripts/validate-settings.mjs ai-setup-settings.json",
    "validate:simulation": "node scripts/validate-awdf-simulation.mjs simulation-result.json ai-setup.json",
    "test:core": "node --test scripts/test-v2.mjs",
    "test:rules": "node scripts/test-ai-tool-rules.mjs",
    "test:description": "node scripts/test-description-regressions.mjs",
    "test:scanner": "node scripts/test-configuration-links.mjs && node scripts/test-scan-safety.mjs",
    "test:references": "node scripts/test-instruction-links.mjs",
    "test:builder-export": "node scripts/test-builder-export.mjs",
    "test:ui": "node scripts/test-ui-v2.mjs",
    "test:server": "node --test scripts/test-server.mjs",
    "test": "npm run test:install && npm run test:core && npm run test:description && npm run test:rules && npm run test:scanner && npm run test:references && npm run test:builder-export && npm run test:server && npm run build",
    "catalog:adopt": "node scripts/update-catalog.mjs adopt",
    "setup": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "workspace:init": "node scripts/setup-workspace.mjs",
    "describe": "node scripts/describe-setup.mjs",
    "prompt:begin": "node scripts/prompt-run.mjs begin",
    "prompt:phase": "node scripts/prompt-run.mjs phase",
    "prompt:review": "node scripts/prompt-run.mjs review",
    "prompt:finalize": "node scripts/prompt-run.mjs finalize",
    "test:install": "node --test scripts/test-install.mjs",
    "setup:codex": "node scripts/bootstrap.mjs codex --scope=project",
    "skill:install:codex": "node scripts/install-skill.mjs codex",
    "recorder:prepare:codex": "node scripts/prepare-recorder.mjs codex",
    "setup:claude_code": "node scripts/bootstrap.mjs claude_code --scope=project",
    "skill:install:claude_code": "node scripts/install-skill.mjs claude_code",
    "recorder:prepare:claude_code": "node scripts/prepare-recorder.mjs claude_code",
    "setup:github_copilot": "node scripts/bootstrap.mjs github_copilot --scope=project",
    "skill:install:github_copilot": "node scripts/install-skill.mjs github_copilot",
    "recorder:prepare:github_copilot": "node scripts/prepare-recorder.mjs github_copilot",
    "skill:install:all": "node scripts/install-skill.mjs all"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@xyflow/react": "12.8.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "elkjs": "0.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "16.28.0",
    "vite": "8.2.0"
  },
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  }
}
